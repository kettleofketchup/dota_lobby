# secrets.yaml: credentials. Copy to secrets.yaml (git-ignored) and never
# commit it; mount it read-only (0400). Found as ./secrets.yaml,
# ./config/secrets.yaml (/app/config/secrets.yaml in the container),
# /run/secrets/dota_lobby/secrets.yaml, $DOTA_LOBBY_SECRETS_DIR/secrets.yaml
# or $DOTA_LOBBY_SECRETS_FILE.
#
# The old list format (secrets.bots: [{username, password}]) still loads,
# with a deprecation warning. Quote every value: an unquoted number is
# rejected at startup.
#
# Bot credentials can instead come from per-bot files in the sops format
# (secrets/bots/<bot>.sops.yaml, decrypted): STEAM_USER, STEAM_PASS,
# STEAM_SHARED_SECRET, STEAM_REFRESH_TOKEN. See credentials_dir in
# config.yaml.example. Those files override this one; env overrides both.
secrets:
  api_key: ""                # API key for X-API-Key / Authorization: Bearer
  webapi_key: ""             # Steam Web API key (match confirmation)
  opendota_key: ""
  webhook_secrets:
    "https://league.internal/hooks/dota": ""
  bots:                      # keyed by bot name (or Steam username)
    league_bot_1:
      password: ""
      shared_secret: ""      # base64 TOTP seed; enables headless re-auth
      refresh_token: ""      # seeds the token store when it is empty;
                             # renewed tokens are kept in state_dir, not here
      device_name: dota_lobby-1
    league_bot_2:
      password: ""
